; Trader-zone independent development baseline; current status is in root PROJECT_STATE.json.
config_version=5

[application]
config/name="EXIT NOT INCLUDED"
config/icon="res://assets/art/ui/dev_icon.svg"
run/main_scene="res://scenes/app/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="zone_trader_lite"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]
locale/fallback="ko"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.075, 0.08, 1)
textures/vram_compression/import_etc2_astc=true
